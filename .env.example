# ========================================
# LangGraph Chatbot Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ========================================
# OpenAI Configuration
# ========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# ========================================
# LangChain Configuration
# ========================================
# LangSmith is optional but recommended for debugging
# Get your API key from: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_YOUR_LANGCHAIN_API_KEY_HERE
LANGCHAIN_PROJECT=chatbot

# ========================================
# Twitter/X API Configuration
# ========================================
# Get your credentials from: https://developer.twitter.com/
# You'll need to create an app and generate API keys
TWITTER_API_KEY=YOUR_TWITTER_API_KEY
TWITTER_API_KEY_SECRET=YOUR_TWITTER_API_SECRET
TWITTER_ACCESS_TOKEN=YOUR_TWITTER_ACCESS_TOKEN
TWITTER_ACCESS_TOKEN_SECRET=YOUR_TWITTER_ACCESS_SECRET

# ========================================
# Alpha Vantage (Stock Data)
# ========================================
# Get your free API key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY

# ========================================
# Service Authentication Tokens
# ========================================
# Generate strong random tokens for inter-service authentication
# You can generate secure tokens using: openssl rand -hex 32
# IMPORTANT: Use different tokens for each service!

# File server authentication
FILE_SERVER_AUTH_TOKEN=YOUR_SECURE_FILE_SERVER_TOKEN_HERE

# Google Drive server authentication
GOOGLE_DRIVE_SERVER_AUTH_TOKEN=YOUR_SECURE_GDRIVE_TOKEN_HERE

# Gmail server authentication
GMAIL_SERVER_AUTH_TOKEN=YOUR_SECURE_GMAIL_TOKEN_HERE

# Twitter server authentication
TWITTER_COMMAND_SERVER_AUTH_TOKEN=YOUR_SECURE_TWITTER_TOKEN_HERE

# ========================================
# Service URLs (Development)
# ========================================
# URLs for microservices - change these for production deployment
TWITTER_SERVER_URL=http://127.0.0.1:5001
FILE_SERVER_URL=http://127.0.0.1:5002
GDRIVE_SERVER_URL=http://127.0.0.1:5003
GMAIL_SERVER_URL=http://127.0.0.1:5004

# ========================================
# Application Configuration
# ========================================
# Environment: development, staging, or production
ENVIRONMENT=development

# Enable debug mode (set to false in production!)
DEBUG=true

# Database path (for SQLite)
DATABASE_PATH=chatbot.db

# File sandbox directory
SANDBOX_DIRECTORY=file_sandbox

# ========================================
# Optional: Production Settings
# ========================================
# Uncomment and configure for production deployment

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting
# RATE_LIMIT_PER_MINUTE=60

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn-here
